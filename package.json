{
  "name": "@jeipidevs/anti-rea",
  "version": "0.1.3",
  "description": "Porteiro (proxy reverso) open source contra engenharia reversa e cópia de sites.",
  "keywords": [
    "proxy",
    "reverse-proxy",
    "anti-scraping",
    "anti-copy",
    "bot-detection",
    "security",
    "devtools",
    "rea"
  ],
  "homepage": "https://github.com/Jeipidevs/anti-rea#readme",
  "bugs": {
    "url": "https://github.com/Jeipidevs/anti-rea/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeipidevs/anti-rea.git"
  },
  "author": "JPStudio",
  "type": "module",
  "bin": {
    "anti-rea": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.en.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "build": "tsc -p .",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
