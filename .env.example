# Copie para .env e preencha só os canais que for usar. Nunca suba o .env para o git.

# Segredo que assina os passes (o assistente gera um sozinho)
ANTI_REA_SECRET=

# Versão do link de dono (inteiro, padrão 1). `npx anti-rea dono --novo` soma 1 e o link antigo deixa de valer
ANTI_REA_OWNER_VERSION=1

# WhatsApp pela Evolution API
ANTI_REA_WHATSAPP_URL=
ANTI_REA_WHATSAPP_INSTANCE=
ANTI_REA_WHATSAPP_TOKEN=
ANTI_REA_WHATSAPP_TO=

# Telegram
ANTI_REA_TELEGRAM_TOKEN=
ANTI_REA_TELEGRAM_CHAT=

# Webhook
ANTI_REA_WEBHOOK_URL=
ANTI_REA_WEBHOOK_SECRET=
